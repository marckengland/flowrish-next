// Prisma v6 Schema — flowrish-next (Multi-Tenant CRM)
// All tenant-scoped models include organizationId FK + index

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ActivityType {
  CALL
  MEETING
  NOTE
  EMAIL
  FILE_ATTACHMENT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum AssignmentRuleType {
  TERRITORY
  DEAL_SIZE
  ROUND_ROBIN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum CadenceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ActionType {
  EMAIL
  CALL
  LINKEDIN
  MANUAL_TASK
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXITED
}

// ─── Multi-Tenancy Models ────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // URL-safe, e.g. "acme-corp"
  plan      String   @default("starter") // canonical PlanSlug: starter | growth | enterprise (see src/lib/plans.ts; legacy "free"/"pro" are normalized)
  voiceProvider String? // preferred voice/calling provider: twilio, telnyx, signalwire, plivo, bandwidth
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams             Team[]
  users             OrganizationMember[]
  invites           OrganizationInvite[]
  leads             Lead[]
  contacts          Contact[]
  companies         Company[]
  pipelines         Pipeline[]
  cadences          Cadence[]
  cadenceSchedules  CadenceSchedule[]
  cadenceStepAttachments CadenceStepAttachment[]
  activities        Activity[]
  tasks             Task[]
  scoringRules      ScoringRule[]
  assignmentRules   AssignmentRule[]
  aiPromptConfigs   AiPromptConfig[]
  scoreDecayConfigs ScoreDecayConfig[]
  emailAccounts     EmailAccount[]
  emailMessages     EmailMessage[]
  fileAttachments   FileAttachment[]
  auditEntries      AuditEntry[]
  scoreHistories    ScoreHistory[]
  forecastSubmissions ForecastSubmission[]
  forecastSnapshots   ForecastSnapshot[]
  coachingComments    CoachingComment[]
  deletionRequests    DeletionRequest[]
  fieldMappings       FieldMapping[]
  stageTransitions    StageTransition[]
  cadenceEnrollments  CadenceEnrollment[]
  insights            Insight[]
  stepExecutionLogs   StepExecutionLog[]
  voiceConfig         VoiceConfig?
  conversations       Conversation[]
  conversationMessages ConversationMessage[]
  receptionistConfig ReceptionistConfig?
  receptionistCalls ReceptionistCall[]
  followUpSuggestions FollowUpSuggestion[]
}

model FollowUpSuggestion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeId     String
  leadId         String
  sourceKey      String
  sourceType     String
  sourceId       String
  sourceThreadId String?
  sourceText     String
  title          String
  description    String
  draftSubject   String       @default("")
  draftBody      String       @default("")
  status         String       @default("PENDING")
  taskId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, sourceKey])
  @@index([organizationId, assigneeId, status, createdAt])
}

model ReceptionistConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ReceptionistCall {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  callSid        String
  turn           Int          @default(0)
  state          Json
  response       String       @default("")
  status         String       @default("active")
  leadId         String?
  taskId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, callSid])
  @@index([organizationId, createdAt])
}

/// Per-organization voice/calling credentials (bring-your-own).
/// Each org supplies its own provider account; secrets are encrypted at rest.
model VoiceConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       @default("twilio")

  // Twilio (in-browser calling). Secrets are stored encrypted.
  twilioAccountSid    String?
  twilioApiKeySid     String?
  twilioApiKeySecret  String? // encrypted (iv:ciphertext)
  twilioTwimlAppSid   String?
  twilioCallerId      String?
  twilioAuthToken     String? // encrypted — used only to verify TwiML webhook signatures

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  isDefault      Boolean      @default(false) // User's default org
  joinedAt       DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  teamId         String?
  invitedById    String
  status         String       @default("pending") // pending, accepted, expired
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([email, organizationId])
  @@index([status])
  @@index([organizationId])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentTeamId   String?
  parentTeam     Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams     Team[]       @relation("TeamHierarchy")
  members        TeamMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([parentTeamId])
}

model TeamMember {
  id     String @id @default(uuid())
  userId String
  teamId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, teamId])
  @@index([teamId])
}

model Role {
  id             String             @id @default(uuid())
  name           String             // OWNER, ADMIN, MANAGER, MEMBER, or custom
  organizationId String?            // null = system default role
  isSystem       Boolean            @default(false) // true for OWNER/ADMIN/MANAGER/MEMBER
  hierarchy      Int                // Lower = more powerful (OWNER=0, ADMIN=1, MANAGER=2, MEMBER=3)
  permissions    RolePermission[]
  teamMembers    TeamMember[]
  invites        OrganizationInvite[]
  createdAt      DateTime           @default(now())

  @@unique([name, organizationId])
  @@index([organizationId])
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String // e.g. "leads:read", "leads:write", "cadences:manage"

  @@unique([roleId, key])
}

// ─── User Model ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  authId    String   @unique // Supabase auth.users.id
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationMemberships OrganizationMember[]
  teamMemberships         TeamMember[]
  assignedLeads           Lead[]
  tasks                   Task[]
  auditEntries            AuditEntry[]
  emailAccounts           EmailAccount[]
  cadencesCreated         Cadence[]            @relation("cadencesCreated")
  enrollmentsCreated      CadenceEnrollment[]  @relation("enrollmentsCreated")
  coachingComments        CoachingComment[]    @relation("coachingComments")
  forecastSubmissions     ForecastSubmission[] @relation("forecastSubmissions")
  deletionRequests        DeletionRequest[]    @relation("deletionRequests")
  conversations           Conversation[]
}

// ─── Lead & Contact Models ───────────────────────────────────────────────────

model Lead {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  altEmail        String?
  phone           String?
  title           String?
  description     String?
  dealValue       Decimal?  @db.Decimal(12, 2)
  currency        String    @default("USD")
  score           Int       @default(0)
  isClosed        Boolean   @default(false)
  closeDate       DateTime?
  leadStatus      String    @default("Open")
  tier            String?
  linkedinUrl     String?
  country         String?
  state           String?
  companyName       String?
  companyIndustry   String?
  companyWebsite    String?
  companyLinkedinUrl String?
  lastActivityAt    DateTime?
  deletedAt         DateTime?

  stageId        String
  stage          Stage    @relation(fields: [stageId], references: [id])
  assignedUserId String?
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  contacts           LeadContact[]
  activities         Activity[]
  tasks              Task[]
  stageTransitions   StageTransition[]
  scoreHistory       ScoreHistory[]
  cadenceEnrollments CadenceEnrollment[]

  // Full-text search vector
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([stageId])
  @@index([assignedUserId])
  @@index([companyId])
  @@index([score])
  @@index([leadStatus])
  @@index([tier])
}

model Contact {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  jobTitle    String?
  linkedinUrl String?
  country     String?
  state       String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leads LeadContact[]

  // Full-text search vector
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([companyId])
}

model Company {
  id       String  @id @default(uuid())
  name     String
  industry String?
  website  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  contacts Contact[]
  leads    Lead[]

  // Full-text search vector
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model LeadContact {
  leadId    String
  contactId String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([leadId, contactId])
}

// ─── Pipeline & Stage Models ─────────────────────────────────────────────────

model Pipeline {
  id   String @id @default(uuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  stages Stage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Stage {
  id           String  @id @default(uuid())
  name         String
  order        Int
  isClosedWon  Boolean @default(false)
  isClosedLost Boolean @default(false)
  pipelineId   String
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id])

  leads Lead[]

  createdAt DateTime @default(now())

  @@unique([pipelineId, order])
}

model StageTransition {
  id          String @id @default(uuid())
  leadId      String
  lead        Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStageId String?
  toStageId   String
  userId      String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  transitionedAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId, transitionedAt])
}

// ─── Activity & Task Models ──────────────────────────────────────────────────

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById String

  // Call fields
  callDate     DateTime?
  callDuration Int? // in seconds

  // Meeting fields
  meetingDate DateTime?
  attendees   String? // JSON array of attendee names

  // Common
  notes          String?
  emailMessageId String?       @unique
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id])

  // AI Summary fields (populated on-demand via conversation intelligence)
  aiSummary   String?
  keyTopics   String[] @default([])
  actionItems String[] @default([])
  sentiment   String?  // "positive" | "neutral" | "negative"

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  files            FileAttachment[]
  coachingComments CoachingComment[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId, createdAt])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime
  isComplete  Boolean      @default(false)
  completedAt DateTime?
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User         @relation(fields: [assigneeId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assigneeId, dueDate])
  @@index([leadId])
}

// ─── Cadence Models ──────────────────────────────────────────────────────────

model Cadence {
  id          String        @id @default(uuid())
  name        String
  status      CadenceStatus @default(DRAFT)
  createdById String
  createdBy   User          @relation("cadencesCreated", fields: [createdById], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]
  schedule    CadenceSchedule?

  /**
   * Cosmetic canvas layout for the visual flow builder: per-node
   * positions keyed by node id ("start", "end", or a CadenceStep id),
   * e.g. { "positions": { "start": { "x": 0, "y": 160 }, ... } }.
   *
   * Purely presentational — the execution order is ALWAYS the linear,
   * contiguous `CadenceStep.stepOrder` the Inngest runner reads. The
   * canvas derives a new stepOrder from the Start→End connection chain
   * and persists it through the normal reorder path; positions here just
   * let the builder restore where the user dragged each node.
   */
  canvasLayout Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
}

/**
 * Per-cadence sending window. Constrains when the Inngest cadence
 * runner is allowed to fire steps for any enrollment on the
 * cadence — outside the window the runner sleeps the enrollment
 * until the next allowed slot. Storing minutes-of-day rather than
 * a `DateTime` keeps the schedule timezone-aware and lets us
 * compare against a localized "now" without DST drift bugs.
 */
model CadenceSchedule {
  id        String  @id @default(uuid())
  cadenceId String  @unique
  cadence   Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  /** Optional friendly name (e.g. "US business hours"). */
  name String @default("Default schedule")

  /** Days of week the cadence is allowed to send. 0=Sun .. 6=Sat. */
  daysOfWeek Int[] @default([1, 2, 3, 4, 5])

  /** Start of allowed window, in minutes from midnight (0–1439). */
  startTimeMinutes Int @default(540) // 9:00 AM

  /** End of allowed window, in minutes from midnight (0–1439). */
  endTimeMinutes Int @default(1020) // 5:00 PM

  /** IANA timezone string (e.g. "America/Los_Angeles"). */
  timezone String @default("UTC")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model CadenceStep {
  id              String     @id @default(uuid())
  cadenceId       String
  cadence         Cadence    @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  stepOrder       Int
  actionType      ActionType
  delayHours      Int        @default(0)
  emailSubject    String?
  emailBody       String?
  taskTitle       String?
  taskDescription String?

  /**
   * Whether this EMAIL step starts a fresh Gmail thread instead of
   * replying on the enrollment's existing thread. Default false so
   * follow-ups thread together by default; flip to true on a breakup
   * step or a re-engagement sequence where a fresh subject reads
   * better than yet another "Re:" reply. Ignored for non-EMAIL steps.
   */
  startNewThread  Boolean    @default(false)

  executionLogs StepExecutionLog[]
  attachments   CadenceStepAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cadenceId, stepOrder])
  @@index([cadenceId])
}

/**
 * Template-level file attachment on a cadence step. Files are uploaded
 * once when the step is authored and re-attached to every outbound
 * email when the step fires for any enrolled lead. Storage layout is
 * per-org: `cadences/{orgId}/{stepId}/{attachmentId}-{filename}`.
 */
model CadenceStepAttachment {
  id           String      @id @default(uuid())
  stepId       String
  step         CadenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  fileName     String
  fileSize     Int
  mimeType     String
  storagePath  String
  uploadedById String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([stepId])
}

model CadenceEnrollment {
  id               String           @id @default(uuid())
  cadenceId        String
  cadence          Cadence          @relation(fields: [cadenceId], references: [id])
  leadId           String
  lead             Lead             @relation(fields: [leadId], references: [id])
  enrolledById     String
  enrolledBy       User             @relation("enrollmentsCreated", fields: [enrolledById], references: [id])
  status           EnrollmentStatus @default(ACTIVE)
  currentStepOrder Int              @default(1)
  exitReason       String?
  emailThreadId    String?          // Gmail thread ID for email threading across steps
  enrolledAt       DateTime         @default(now())
  completedAt      DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  executionLogs StepExecutionLog[]

  updatedAt DateTime @updatedAt

  // Nonterminal per-status uniqueness is enforced by a partial SQL index;
  // terminal enrollment history may contain repeated outcomes.
  @@index([cadenceId, leadId, status])
  @@index([organizationId])
  @@index([cadenceId, status])
  @@index([leadId])
  @@index([enrolledById])
}

model StepExecutionLog {
  id           String            @id @default(uuid())
  enrollmentId String
  enrollment   CadenceEnrollment @relation(fields: [enrollmentId], references: [id])
  stepId       String
  step         CadenceStep       @relation(fields: [stepId], references: [id])
  actionType   ActionType
  outcome      String
  errorMessage String?
  attemptCount Int               @default(1)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  executedAt DateTime @default(now())

  @@index([organizationId])
  @@index([enrollmentId])
  @@index([stepId])
}

// ─── Email Models ────────────────────────────────────────────────────────────

model EmailAccount {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  provider     String    // "gmail", "outlook", etc.
  email        String
  accessToken  String    // encrypted
  refreshToken String    // encrypted
  tokenExpiry  DateTime
  lastSyncAt   DateTime?
  syncStatus   String    @default("idle")
  syncRequestedAt DateTime?
  syncAttemptAt DateTime?
  syncRunId    String?
  syncError    String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
}

model EmailMessage {
  id          String    @id @default(uuid())
  externalId  String    // provider message ID, scoped to the connected mailbox
  accountId   String?
  replyMetadata Json?
  threadId    String?   // provider thread ID for reply-in-thread
  fromEmail   String
  toEmail     String
  subject     String
  bodyPreview String?
  sentAt      DateTime

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  activity Activity?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([threadId])
  @@unique([organizationId, accountId, externalId])
  @@index([organizationId, externalId])
}

// ─── File Storage ────────────────────────────────────────────────────────────

model FileAttachment {
  id           String   @id @default(uuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fileName     String
  fileSize     Int      // bytes
  mimeType     String
  storagePath  String   // Supabase Storage path
  uploadedById String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([activityId])
}

// ─── Audit & Compliance ──────────────────────────────────────────────────────

model AuditEntry {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String      // "Lead", "Contact", "Company", "StageTransition"
  entityId   String
  changes    Json?       // { field: { old: value, new: value } }

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Scoring & Assignment Models ─────────────────────────────────────────────

model ScoringRule {
  id       String  @id @default(uuid())
  type     String  // activity_count, deal_value, stage_progression, email_engagement
  points   Int
  config   Json
  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model ScoreHistory {
  id            String @id @default(uuid())
  leadId        String
  lead          Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousScore Int
  newScore      Int
  reason        String // e.g., "activity_logged", "decay", "rule_change"

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId, createdAt])
}

model ScoreDecayConfig {
  id             String  @id @default(uuid())
  inactivityDays Int
  pointReduction Int
  isActive       Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model AssignmentRule {
  id       String             @id @default(uuid())
  type     AssignmentRuleType
  priority Int
  config   Json               // territory, deal size range, or round-robin config
  isActive Boolean            @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, priority])
  @@index([organizationId])
}

/**
 * Saved AI/enrichment output ("Insights") attached to a Lead, Company, or
 * Contact. Persists the structured result of account research / background
 * checks / lead-gen enrichment so it's available as a reference on the
 * record and reusable by email generation, cadences, and the assistant.
 * Polymorphic by (entityType, entityId); tenant-scoped by organizationId.
 */
model Insight {
  id         String  @id @default(uuid())
  entityType String // "LEAD" | "COMPANY" | "CONTACT"
  entityId   String
  kind       String  @default("research") // research | background | leadgen
  summary    String?
  /** Full structured payload (e.g. the AccountResearch object). */
  data       Json
  /** Source URLs / citations backing the insight. */
  sources    String[] @default([])
  /** Where it came from: ai | exa | osm | apollo | manual. */
  source      String @default("ai")
  createdById String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
}

// ─── Forecast Models ─────────────────────────────────────────────────────────

model ForecastSubmission {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation("forecastSubmissions", fields: [userId], references: [id])
  period       String  // e.g. "2026-05" for May 2026
  commitAmount Decimal @db.Decimal(12, 2)
  notes        String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId, period])
  @@index([period])
}

model ForecastSnapshot {
  id               String  @id @default(uuid())
  period           String
  totalPipeline    Decimal @db.Decimal(12, 2)
  weightedPipeline Decimal @db.Decimal(12, 2)
  aiPredicted      Decimal @db.Decimal(12, 2)
  closedWon        Int
  closedLost       Int

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  snapshotDate DateTime @default(now())

  @@index([organizationId])
  @@index([period, snapshotDate])
}

// ─── AI & Coaching Models ────────────────────────────────────────────────────

model AiPromptConfig {
  id           String  @id @default(uuid())
  key          String  // e.g. "email_generation", "account_research"
  name         String
  systemPrompt String
  isActive     Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model CoachingComment {
  id              String   @id @default(uuid())
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation("coachingComments", fields: [authorId], references: [id])
  mentionedUserId String?
  content         String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([activityId])
  @@index([mentionedUserId])
}

// ─── Deletion Request Model ──────────────────────────────────────────────────

model DeletionRequest {
  id            String    @id @default(uuid())
  entityType    String    // "Lead", "Contact", "Task"
  entityId      String
  entityName    String    // Display name for the entity
  reason        String?
  requestedById String
  requestedBy   User      @relation("deletionRequests", fields: [requestedById], references: [id])
  status        String    @default("pending") // "pending", "approved", "rejected"
  reviewedById  String?
  reviewedAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([status])
  @@index([requestedById])
}

// ─── CSV Field Mapping Model ─────────────────────────────────────────────────

model FieldMapping {
  id          String @id @default(uuid())
  name        String
  mapping     Json   // { csvColumn: systemField }
  createdById String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
}


// ─── Private-beta waitlist ───────────────────────────────────────────────────

/// Email-capture list for the private beta. Prospective users submit their
/// email (and optionally a name) from the marketing landing page; invited
/// testers later graduate to a real account via /onboarding.
/// status: pending | invited | joined
model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique // stored lowercased + trimmed
  name      String?
  status    String   @default("pending") // pending | invited | joined
  source    String? // where they signed up from, e.g. "landing"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── AI Assistant Conversations ──────────────────────────────────────────────

/// A persisted Airish (AI assistant) chat thread, scoped to one user
/// within an organization. Durable across refreshes and devices — unlike
/// the prior per-tab sessionStorage. `title` is derived from the first
/// user message and may be renamed later.
model Conversation {
  id     String  @id @default(uuid())
  title  String?
  userId String
  user   User    @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  messages ConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId, updatedAt])
}

/// A single turn in a Conversation. Append-only (only createdAt). We store
/// just the plain user/assistant text exchange — ephemeral action cards
/// and their statuses are never persisted, so a reloaded thread can't
/// re-trigger a stale action.
model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([conversationId, createdAt])
}
