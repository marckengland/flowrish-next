# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Pooled connection (Transaction mode, port 6543) — used by the app at runtime
# MUST include ?pgbouncer=true — do NOT add &connection_limit=1
DATABASE_URL=postgresql://postgres.your-project:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (Session mode, port 5432) — used for migrations only
# Do NOT add ?pgbouncer=true here
DIRECT_URL=postgresql://postgres.your-project:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Inngest (Background Jobs) ───────────────────────────────────────────────
# Event key for sending events from the app
INNGEST_EVENT_KEY=your-event-key
# Signing key — set as env var, SDK reads it automatically (no code reference needed)
INNGEST_SIGNING_KEY=your-signing-key

# ─── Google OAuth (Login + Gmail Integration) ────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Client-side Google Client ID — needed for the Gmail connect button in Settings.
# This is the same value as GOOGLE_CLIENT_ID, exposed to the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Email Encryption ────────────────────────────────────────────────────────
# 32-byte hex string for AES-256-CBC encryption of OAuth tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=your-64-char-hex-string

# ─── AI Service (Optional) ───────────────────────────────────────────────────
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash-lite-preview

# ─── End-to-End Tests (optional) ─────────────────────────────────────────────
# Email of an existing Supabase user used by the Playwright smoke suite.
# The setup project mints a magic link for this user via the Supabase
# admin API (so SUPABASE_SECRET_KEY must also be set above) and signs in
# without leaving the test process.
E2E_TEST_USER_EMAIL=test@example.com
