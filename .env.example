# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Pooled connection (Transaction mode, port 6543) — used by the app at runtime
# MUST include ?pgbouncer=true — do NOT add &connection_limit=1
DATABASE_URL=postgresql://postgres.your-project:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (Session mode, port 5432) — used for migrations only
# Do NOT add ?pgbouncer=true here
DIRECT_URL=postgresql://postgres.your-project:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Site / Public URLs ──────────────────────────────────────────────────────
# Canonical site URL. Drives SEO metadata, canonical tags, sitemap.xml, and
# robots.txt (src/lib/site.ts). Falls back to https://flowrish.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL used to build organization invite links emailed to invitees
# (src/app/api/admin/invite/route.ts). On Vercel this is auto-derived from the
# platform-injected VERCEL_URL; set it explicitly for other hosts. Falls back
# to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Inngest (Background Jobs) ───────────────────────────────────────────────
# Event key for sending events from the app
INNGEST_EVENT_KEY=your-event-key
# Signing key — set as env var, SDK reads it automatically (no code reference needed)
INNGEST_SIGNING_KEY=your-signing-key

# ─── Google OAuth (Login + Gmail Integration) ────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Client-side Google Client ID — needed for the Gmail connect button in Settings.
# This is the same value as GOOGLE_CLIENT_ID, exposed to the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Email Encryption ────────────────────────────────────────────────────────
# 32-byte hex string for AES-256-CBC encryption of OAuth tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=your-64-char-hex-string

# ─── AI Service (Optional) ───────────────────────────────────────────────────
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash-lite-preview

# ─── Microsoft 365 / Outlook Email (Optional) ────────────────────────────────
# One Azure AD app for the whole deployment; each user connects their own
# mailbox via OAuth. When unset, the Outlook connector in Settings shows the
# self-serve Azure setup instructions instead of a connect button.
# Register at https://entra.microsoft.com → App registrations. Redirect URI:
#   https://<your-domain>/api/email/microsoft/callback
# Delegated Graph scopes: offline_access User.Read Mail.Read Mail.Send
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
# Same client id, exposed to the browser for the OAuth authorize URL.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-azure-app-client-id

# ─── Telephony / Calling ─────────────────────────────────────────────────────
# NOTE: Calling is bring-your-own and configured PER ORGANIZATION inside the
# app (Settings → Calling & voice), NOT via environment variables. Each org
# stores its own Twilio credentials (encrypted at rest). There are no Twilio
# env vars to set here.

# ─── End-to-End Tests (Playwright) ───────────────────────────────────────────
# See docs/TESTING.md for the full picture. Quick notes:
#
# Email of an existing Supabase user used by the Playwright suite. The `setup`
# project mints a magic link for this user via the Supabase admin API (so
# SUPABASE_SECRET_KEY must also be set above) and signs in without leaving the
# test process.
E2E_TEST_USER_EMAIL=test@example.com
#
# IMPORTANT for local e2e: `npm run test:e2e` starts a real local dev server and
# drives the /auth/confirm route, which validates the FULL env schema. A
# placeholder EMAIL_ENCRYPTION_KEY (above) makes that route 500 and the sign-in
# silently fails ("No Supabase auth cookie…"). Set a real 64-hex key for local
# e2e to work.
#
# Target a DEPLOYED URL instead of a local server. Leave this UNSET for local
# runs. `npm run test:e2e:prod` injects it via `node --env-file=.env`, so it's
# honored there; a plain `npm run test:e2e` deliberately ignores a value that
# only lives in .env and always runs locally.
# PLAYWRIGHT_BASE_URL=https://your-app.example.com
#
# Advanced (optional):
# - E2E_ALLOW_WRITES=1  → allow @write specs to run against a deployed URL
#   (they mutate data; used by `npm run test:e2e:prod:write`). Off by default.
# - E2E_BYPASS_TOKEN=…  → sent as the `x-e2e-bypass` header to skip rate limits
#   on repeated prod runs. Only useful if the app validates it server-side
#   (not wired by default).

# --- Feature flags ---
# Private-beta waitlist. Default: enabled (unset = enabled). Set to "false" to
# switch marketing CTAs to open signup (/onboarding), hide the waitlist form,
# and disable POST /api/waitlist.
WAITLIST_ENABLED=true

# --- Transactional email (waitlist confirmations) ---
# Optional. Without these, waitlist signups are still saved but no confirmation
# email is sent (the send is a best-effort no-op).
RESEND_API_KEY=
RESEND_FROM="Flowrish <onboarding@resend.dev>"

# ─── Discord Feedback Triage (dev tool, script-only) ─────────────────────────
# Used only by `npm run discord:feedback` (scripts/discord-feedback.ts), a
# developer tool that pulls user feedback from a Discord channel's threads
# (text + screenshots downloaded locally) so Kiro can triage and fix them, and
# lets you react to mark a thread done once its fix ships. No AI key needed —
# Kiro does the reading/triage. Not part of the app runtime — safe to leave unset.
#
# Bot setup: https://discord.com/developers/applications → New Application →
# Bot. Enable the "Message Content Intent" (Bot → Privileged Gateway Intents).
# Invite it to your server with the View Channels, Read Message History, and
# Add Reactions permissions. Copy the bot token below.
DISCORD_BOT_TOKEN=your-discord-bot-token
# The text channel whose threads to triage. In Discord, enable Developer Mode
# (Settings → Advanced), then right-click the channel → Copy Channel ID.
DISCORD_FEEDBACK_CHANNEL_ID=your-channel-id
# Reaction used to mark a thread done. Default: ✅
DISCORD_DONE_EMOJI=✅

# ─── Demo Data Seeder (dev tool, script-only) ────────────────────────────────
# Used by `npm run seed:demo` (prisma/seed-demo.ts) to fill ONE organization
# with clearly-labeled demo data so every feature can be exercised without
# hand-filling forms. SAFETY: this can run against production, so it refuses to
# write unless SEED_DEMO_CONFIRM=yes. The target org is resolved from
# SEED_ORG_SLUG, else SEED_USER_EMAIL (which falls back to E2E_TEST_USER_EMAIL).
# Not part of the app runtime — safe to leave unset.
# SEED_ORG_SLUG=your-org-slug
# SEED_USER_EMAIL=owner@example.com
# SEED_DEMO_CONFIRM=yes
