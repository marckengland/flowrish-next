{
  "name": "flowrish-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/write-release-metadata.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck:fast": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:receptionist:integration": "vitest run --config vitest.receptionist.config.ts",
    "test:receptionist:mocked": "node scripts/run-receptionist-rehearsal.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:prod": "node --env-file=.env node_modules/.bin/playwright test",
    "test:e2e:prod:write": "E2E_ALLOW_WRITES=1 node --env-file=.env node_modules/.bin/playwright test e2e/forms.spec.ts",
    "setup:storage": "tsx scripts/setup-supabase-storage.ts",
    "seed:demo": "node --env-file=.env --import tsx prisma/seed-demo.ts",
    "seed:demo:clean": "SEED_DEMO_CLEAN=1 node --env-file=.env --import tsx prisma/seed-demo.ts",
    "discord:feedback": "tsx scripts/discord-feedback.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@flowgram.ai/fixed-layout-editor": "1.0.14",
    "@flowgram.ai/free-layout-editor": "1.0.14",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.4",
    "@tanstack/react-query": "5.100.10",
    "@tiptap/extension-color": "3.23.5",
    "@tiptap/extension-font-family": "3.23.5",
    "@tiptap/extension-link": "3.23.5",
    "@tiptap/extension-text-style": "3.23.5",
    "@tiptap/extension-underline": "3.23.5",
    "@tiptap/pm": "3.23.5",
    "@tiptap/react": "3.23.5",
    "@tiptap/starter-kit": "3.23.5",
    "@twilio/voice-sdk": "^2.18.3",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "discord.js": "^14.27.0",
    "inngest": "4.4.0",
    "lucide-react": "1.14.0",
    "mammoth": "1.13.0",
    "next": "15.5.18",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.12.0",
    "shadcn": "4.7.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.9.1",
    "zod": "3.25.76",
    "zustand": "5.0.13"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "4.1.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.28.0",
    "eslint-config-next": "15.5.18",
    "fast-check": "3.23.2",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.6",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
